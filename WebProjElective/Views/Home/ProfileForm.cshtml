@using System.Security.Claims
@model UserCart

@{
    bool editAddress = Context.Request.Query["editAddress"] == "true";
    string returnUrl = Context.Request.Query["returnUrl"];
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grocery Store</title>
    <link rel="stylesheet" href="site.css">
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <header class="header">
        <a href="#" class="logo">
            <img src="~/images/grocerylogo.png" alt=""> ElectroMart
        </a>
        <nav class="navbar">
            <a href="/Home/Dashboard">Home</a>
            <a href="/Home/Dashboard#features">Features</a>
            <a href="/Home/Dashboard#categories">Categories</a>
        </nav>

        <div class="icons">
            <a href="#" class="icon"><i class="fas fa-bars" id="menu-btn"></i></a>
            <a href="#" class="icon"><i class="fas fa-search" id="search-btn"></i></a>
            <a href="#" class="icon"><i class="fas fa-shopping-cart" id="cart-btn"></i></a>
            <div class="user-info-container">
                <button class="user-info-button" id="user-btn">
                    <i class="fas fa-user" id="login-btn"></i>
                    @* <img src="~/images/user-pflaceholder.png"> *@
                </button>
                <div class="user-info-dropdown" id="user-info">
                    <a href="#"><i class="fas fa-user"></i>Profile</a>
                    <a href="/Home/MyOrderForm"><i class="fas fa-box"></i>Orders</a>
                    <a href="/Home/Logout"><i class="fas fa-sign-out-alt"></i>Log Out</a>
                </div>
            </div>
        </div>

        <div class="shopping-cart">
            @if (Model != null && Model.Carts.Any())
            {
                @foreach (var cart in Model.Carts)
                {
                    <div class="box">
                        <i class="fas fa-trash" data-id="@cart.ProdId" onclick="deleteItem(this)"></i>
                        <img src="data:image;base64,@Convert.ToBase64String(cart.ProdImage)" alt="@cart.ProdName" />
                        <div class="content">
                            <h3>@cart.ProdName</h3>
                            <span class="price">@cart.ProdPrice</span>
                            <span class="quantity">qty : 1</span>
                        </div>
                    </div>
                }

                <div class="total">total : Php @Model.Carts.Sum(cart => cart.ProdPrice)</div>
                <form action="/Home/CheckoutForm">
                    <button type="submit" class="btn">Checkout</button>
                </form>
            }
            else
            {
                <p>Your cart is empty.</p>
            }
        </div>


        <form action="/Home/Login" method="post" class="search-form">
            <input type="search" id="search-box" placeholder="search here....">
            <label for="search-box" class="fas fa-search"></label>
        </form>


    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <span class="close-btn">&times;</span>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <span class="close-btn">&times;</span>
            @TempData["ErrorMessage"]
        </div>
    }
    <!-- Home Section ni dria-->


    <main>
        <!-- Success and error messages -->
        <section id="profile" class="profile-section">
            <h2>User Profile</h2>
            <div class="profile-details">
                <div class="form-group">
                    <label>Username:</label>
                    <p style="text-transform: none;">@Model.User.UserName</p>
                </div>

                <div class="form-group">
                    <label>Name:</label>
                    <p style="text-transform: none;">@Model.User.FName @Model.User.LName</p>
                </div>

                <div class="form-group">
                    <label>Email:</label>
                    <p style="text-transform: none;">@Model.User.Email</p>
                </div>

                <div class="form-group">
                    <label>Phone Number:</label>
                    <p>@Model.User.PNumber</p>
                </div>

                <div class="form-group">
                    <label>Address:</label>
                    <p>@Model.User.StAddress, @Model.User.City, @Model.User.Province</p>
                </div>

                <div class="form-group">
                    <label>Birthdate:</label>
                    <p>@Model.User.BDate.ToString("yyyy/MM/dd")</p>
                </div>



            </div>
        </section>


        <!-- Your main content goes here -->
    </main>

    <style>
        /* General profile display styling */
.profile-section {
    width: 50%;
    margin: 0 auto;
    padding: 20px;
    background-color: #f9f9f9;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
}

.profile-section h2 {
    text-align: center;
    margin-bottom: 20px;
    font-size: 24px;
    color: #333;
}

.profile-details .form-group {
    margin-bottom: 15px;
}

.profile-details label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #555;
}

.profile-details p {
    padding: 10px;
    background-color: #fff;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
    color: #333;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.1);
}

.profile-details .btn {
    display: block;
    width: 100%;
    padding: 10px;
    background-color: #007bff;
    color: #fff;
    font-size: 18px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-align: center;
    margin-top: 20px;
}

.profile-details .btn:hover {
    background-color: #0056b3;
}
    </style>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="site.js"></script>

    <script>
        function deleteItem(element) {
            var prodId = element.getAttribute("data-id");

            if (confirm("Are you sure you want to delete this item?")) {
                fetch(`/Home/DeleteCartItem?prodId=${prodId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                    .then(response => {
                        if (response.ok) {
                            element.parentElement.remove(); // Remove item from the UI
                        } else {
                            alert("Failed to delete item.");
                        }
                    })
                    .catch(error => console.error('Error:', error));
            }
        }

    </script>
</body>
</html>