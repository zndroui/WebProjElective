@using System.Security.Claims
@model UserCart

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grocery Store - Checkout</title>
    <link rel="stylesheet" href="site.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <header class="header">
        <a href="#" class="logo">
            <img src="~/images/grocerylogo.png" alt=""> ElectroMart
        </a>

        <nav class="navbar">
            <a href="/Home/Dashboard">Home</a>
            <a href="/Home/Dashboard#features">Features</a>
            <a href="/Home/Dashboard#categories">Categories</a>
        </nav>

        <div class="icons">
            <div class="user-info-container">
                <button class="user-info-button">
                    <i class="fas fa-user"></i>
                </button>
                <div class="user-info-dropdown">
                    <a href="/Home/ProfileForm"><i class="fas fa-user"></i> Profile</a>
                    <a href="/Home/MyOrderForm"><i class="fas fa-box"></i> Orders</a>
                    <a href="/Home/Logout"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                </div>
            </div>
        </div>
    </header>

    <main>

        <!-- DELIVERY ADDRESS -->
        <section class="delivery-address">
            <h2>Delivery Address</h2>

            <p><strong>@Model.User.FName @Model.User.LName</strong></p>
            <p>@Model.User.StAddress, @Model.User.City, @Model.User.Province</p>
            <p>@Model.User.PNumber</p>

            <a href="/Home/UpdateShipping" class="edit-address-btn">
                <i class="fas fa-edit"></i> Edit Shipping Address
            </a>
        </section>

        <!-- PRODUCTS ORDERED -->
        <section class="products-ordered">
            <h2>Products Ordered</h2>

            @foreach (var cart in Model.Carts)
            {
                <div class="product-item">
                    <div class="product-info">
                        <img src="data:image;base64,@Convert.ToBase64String(cart.ProdImage)" />
                        <div>
                            <h4>@cart.ProdName</h4>
                            <p>AUD @cart.ProdPrice</p>
                        </div>
                    </div>
                    <div>Qty: 1</div>
                    <div>AUD @cart.ProdPrice</div>
                </div>
            }

            <div class="shipping-fee">Shipping Fee: AUD 7.75</div>
            <div class="order-total">
                Order Total: AUD @((Model.Carts.Sum(c => c.ProdPrice) + 7.75).ToString("F2"))
            </div>
        </section>

        <!-- SHIPPING OPTION -->
        <section>
            <h2>Shipping Option</h2>
            <p>Standard Local</p>
            <p>Fee: AUD 7.75</p>
        </section>

        <!-- PAYMENT -->
        <section>
            <h2>Payment Method</h2>
            <p>Cash on Delivery</p>
        </section>

        <!-- PLACE ORDER -->
        <section class="place-order">
            <form method="post" asp-action="CheckoutForm">
                <input type="hidden" name="UN" value="@Model.User.UserName" />
                <input type="hidden" name="DatePlaced" value="@DateTime.Now" />
                <input type="hidden" name="Shipping" value="Standard Local" />
                <input type="hidden" name="PayMethod" value="Cash on Delivery" />
                <input type="hidden" name="TotalPrice" value="@((Model.Carts.Sum(c => c.ProdPrice) + 7.75).ToString("F2"))" />

                <button type="submit">Place Order</button>
            </form>
        </section>

    </main>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f8f8f8;
            margin: 0;
        }

        .header {
            position: fixed;
            top: 0;
            width: 100%;
            background: #ff6600;
            padding: 10px 20px;
            z-index: 1000;
        }

        main {
            padding: 100px 20px 20px;
        }

        section {
            background: white;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 6px;
        }

        .product-item {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #ddd;
            padding: 10px 0;
        }

        .product-info {
            display: flex;
            gap: 10px;
        }

            .product-info img {
                width: 60px;
                height: 60px;
            }

        .order-total {
            text-align: right;
            font-weight: bold;
            font-size: 18px;
        }

        .shipping-fee {
            text-align: right;
            font-size: 14px;
            margin-top: 10px;
        }

        .place-order button {
            width: 100%;
            padding: 15px;
            background: #ff6600;
            color: white;
            border: none;
            font-size: 18px;
            border-radius: 5px;
            cursor: pointer;
        }

            .place-order button:hover {
                background: #cc5200;
            }

        /* EDIT ADDRESS BUTTON */
        .edit-address-btn {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 14px;
            background: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-size: 14px;
        }

            .edit-address-btn:hover {
                background: #0056b3;
            }
    </style>

</body>
</html>
