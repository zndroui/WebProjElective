@model UserCart

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Update Shipping Address</title>
    <link rel="stylesheet" href="site.css">
</head>
<body>

    <main class="update-shipping">

        <h2>Update Shipping Address</h2>

        <form method="post" asp-action="UpdateShipping">

            <input type="hidden" name="UserName" value="@Model.User.UserName" />

            <div class="form-group">
                <label>Street Address</label>
                <input type="text"
                       name="StAddress"
                       value="@Model.User.StAddress"
                       required />
            </div>

            <div class="form-group">
                <label>City</label>
                <input type="text"
                       name="City"
                       value="@Model.User.City"
                       required />
            </div>

            <div class="form-group">
                <label>Province</label>
                <input type="text"
                       name="Province"
                       value="@Model.User.Province"
                       required />
            </div>

            <div class="actions">
                <button type="submit" class="btn">Save Address</button>
                <a href="/Home/CheckoutForm" class="cancel-btn">Cancel</a>
            </div>

        </form>

    </main>

    <style>
        .update-shipping {
            width: 40%;
            margin: 80px auto;
            background: #fff;
            padding: 25px;
            border-radius: 8px;
        }

        .form-group {
            margin-bottom: 15px;
        }

            .form-group label {
                font-weight: bold;
                display: block;
                margin-bottom: 5px;
            }

            .form-group input {
                width: 100%;
                padding: 10px;
                font-size: 16px;
            }

        .actions {
            display: flex;
            gap: 10px;
        }

        .btn {
            flex: 1;
            padding: 12px;
            background: #ff6600;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
        }

        .cancel-btn {
            flex: 1;
            text-align: center;
            padding: 12px;
            background: #ccc;
            text-decoration: none;
            color: black;
        }
    </style>

</body>
</html>
